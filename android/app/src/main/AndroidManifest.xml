<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res-android"
    package="com.ruko.voiceagent">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:label="Ruko Voice Agent"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <!--
          Note: android:usesCleartextTraffic is intentionally omitted. Cleartext
          (HTTP) traffic is denied globally and only permitted for local
          development hosts, as configured in network_security_config.xml.
        -->
    </application>

</manifest>
