<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows cleartext (HTTP) traffic to the Android emulator host (10.0.2.2)
    for development. Production deployments should use HTTPS and remove this
    file (or restrict cleartextTrafficPermitted to false).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator localhost alias -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Physical device localhost (if using adb reverse / ngrok) -->
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
