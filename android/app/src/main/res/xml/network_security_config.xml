<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development only: allow cleartext (HTTP) on the Android emulator
         host alias and local loopback addresses so the app can reach a
         local token server during development. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Production: all other domains must use HTTPS. This protects Twilio
         Access Tokens and other sensitive traffic from interception. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
