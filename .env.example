# Copy this file to .env and fill in the values below.
# Never commit your real .env file or secrets to source control.

# Port the Express server listens on.
PORT=3000

# Required: application-level API key that clients must present to call the
# /token endpoint as an `X-API-Key` header. There is no query-parameter
# fallback (query strings can leak into access logs, browser history, or
# proxy logs). Without this key set, the server refuses to start
# authenticating requests and /token responds with 500. Generate a strong
# random value, e.g. `openssl rand -hex 32`. There is no default — you must
# set this explicitly.
TWILIO_API_KEY=

# Twilio Account SID (Console > Account Info).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio API Key SID/Secret used to sign Voice Access Tokens.
# Create one at Console > Account > API keys & tokens.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret

# TwiML Application SID used for outgoing voice calls.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
