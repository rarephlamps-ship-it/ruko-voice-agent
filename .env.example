# Copy this file to .env and fill in the values below.
# Never commit your real .env file or secrets to source control.

# Port the Express server listens on.
PORT=3000

# Required: application-level API key that clients must present to call the
# /token endpoint, either as a `?api_key=` query parameter or an
# `X-API-Key` header. Without this key, requests to /token are rejected
# with HTTP 401 Unauthorized. Generate a strong random value for
# production, e.g. `openssl rand -hex 32`. The default below is for local
# development only and MUST be changed before deploying.
TWILIO_API_KEY=dev-key-insecure

# Twilio Account SID (Console > Account Info).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio API Key SID/Secret used to sign Voice Access Tokens.
# Create one at Console > Account > API keys & tokens.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret

# TwiML Application SID used for outgoing voice calls.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
